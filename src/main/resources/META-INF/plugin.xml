<idea-plugin>
    <id>dev.maxblack.learn-shortcuts</id>
    <name>LearnShortcuts</name>
    <vendor url="https://github.com/MaxBlack-dev">MaxBlack</vendor>

    <description><![CDATA[
        <b>LearnShortcuts</b> — Master every IntelliJ IDEA keyboard shortcut through
        interactive, context-aware practice sessions.<br/><br/>
        Shortcuts are loaded dynamically from your active keymap, so whatever OS
        or custom keymap you use, you always practice the right binding.
    ]]></description>

    <!-- Works with any IntelliJ-based IDE that has the platform + Java plugin -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!-- ── Tool Window ─────────────────────────────────────────── -->
        <toolWindow
            id="LearnShortcuts"
            displayName="LearnShortcuts"
            anchor="right"
            secondary="false"
            factoryClass="dev.maxblack.learnshortcuts.ui.toolwindow.LearnShortcutsToolWindowFactory"
            icon="/icons/learn-shortcuts.svg"/>

        <!-- ── Application-level Settings ────────────────────────── -->
        <applicationConfigurable
            instance="dev.maxblack.learnshortcuts.ui.settings.SettingsConfigurable"
            id="dev.maxblack.learnshortcuts.settings"
            displayName="LearnShortcuts"
            parentId="tools"/>

        <!-- ── Persistent State Services ─────────────────────────── -->
        <applicationService
            serviceImplementation="dev.maxblack.learnshortcuts.core.state.PluginState"/>
        <applicationService
            serviceImplementation="dev.maxblack.learnshortcuts.core.state.StatisticsState"/>

        <!-- Project-scoped: holds per-project session manager instance -->
        <projectService
            serviceImplementation="dev.maxblack.learnshortcuts.core.engine.SessionManagerService"/>

        <!-- ── Startup Activity ───────────────────────────────────── -->
        <postStartupActivity
            implementation="dev.maxblack.learnshortcuts.LearnShortcutsPlugin"/>

    </extensions>

    <actions>
        <action
            id="LearnShortcuts.OpenPractice"
            class="dev.maxblack.learnshortcuts.ui.actions.OpenPracticeAction"
            text="Open LearnShortcuts"
            description="Start or resume a LearnShortcuts practice session">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
            id="LearnShortcuts.ShowStatistics"
            class="dev.maxblack.learnshortcuts.ui.actions.ShowStatisticsAction"
            text="LearnShortcuts Statistics"
            description="Show LearnShortcuts practice statistics">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>
