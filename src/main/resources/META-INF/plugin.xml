<idea-plugin>
    <id>dev.maxblack.shortcut-sensei</id>
    <name>ShortcutSensei</name>
    <vendor url="https://github.com/MaxBlack-dev">MaxBlack</vendor>

    <description><![CDATA[
        <b>ShortcutSensei</b> — Master every IntelliJ IDEA keyboard shortcut through
        interactive, context-aware practice sessions.<br/><br/>
        Shortcuts are loaded dynamically from your active keymap, so whatever OS
        or custom keymap you use, you always practice the right binding.
    ]]></description>

    <!-- Works with any IntelliJ-based IDE that has the platform + Java plugin -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!-- ── Tool Window ─────────────────────────────────────────── -->
        <toolWindow
            id="ShortcutSensei"
            displayName="ShortcutSensei"
            anchor="right"
            secondary="false"
            factoryClass="dev.maxblack.shortcutsensei.ui.toolwindow.ShortcutSenseiToolWindowFactory"
            icon="/icons/shortcut-sensei.svg"/>

        <!-- ── Application-level Settings ────────────────────────── -->
        <applicationConfigurable
            instance="dev.maxblack.shortcutsensei.ui.settings.SettingsConfigurable"
            id="dev.maxblack.shortcutsensei.settings"
            displayName="ShortcutSensei"
            parentId="tools"/>

        <!-- ── Persistent State Services ─────────────────────────── -->
        <applicationService
            serviceImplementation="dev.maxblack.shortcutsensei.core.state.PluginState"/>
        <applicationService
            serviceImplementation="dev.maxblack.shortcutsensei.core.state.StatisticsState"/>

        <!-- Project-scoped: holds per-project session manager instance -->
        <projectService
            serviceImplementation="dev.maxblack.shortcutsensei.core.engine.SessionManagerService"/>

        <!-- ── Startup Activity ───────────────────────────────────── -->
        <postStartupActivity
            implementation="dev.maxblack.shortcutsensei.ShortcutSenseiPlugin"/>

    </extensions>

    <actions>
        <action
            id="ShortcutSensei.OpenPractice"
            class="dev.maxblack.shortcutsensei.ui.actions.OpenPracticeAction"
            text="Open ShortcutSensei"
            description="Start or resume a ShortcutSensei practice session">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
            id="ShortcutSensei.ShowStatistics"
            class="dev.maxblack.shortcutsensei.ui.actions.ShowStatisticsAction"
            text="ShortcutSensei Statistics"
            description="Show ShortcutSensei practice statistics">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>
